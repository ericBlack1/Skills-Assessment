# Copy to .env and fill in your own values. Never commit .env.

# Application
APP_NAME="Task Manager API"
APP_VERSION="0.1.0"
DEBUG=false

# PostgreSQL connection string. Quoted because it may contain "&".
# Local:  postgresql://user:password@localhost:5432/taskmanager
# Hosted: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://taskmanager:change-me@localhost:5432/taskmanager"
