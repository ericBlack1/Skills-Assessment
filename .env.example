# Copy to .env and fill in your own values. Never commit .env.

# Application
APP_NAME="Task Manager API"
APP_VERSION="0.1.0"
DEBUG=false

# JWT (required for registration/login)
JWT_SECRET=change-me-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Local development (PostgreSQL on localhost)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://taskmanager:change-me@localhost:5432/taskmanager"

# Optional dedicated PostgreSQL database for pytest. If omitted, tests start a
# temporary Docker container automatically and never use DATABASE_URL.
# TEST_DATABASE_URL="postgresql://taskmanager:change-me@localhost:5432/taskmanager_test"

# ---------------------------------------------------------------------------
# Docker Compose (copy these values to .env when using docker compose)
# The API service connects to the "db" hostname on Docker's internal network.
# ---------------------------------------------------------------------------
# POSTGRES_USER=taskmanager
# POSTGRES_PASSWORD=taskmanager_dev_password
# POSTGRES_DB=taskmanager
# API_PORT=8000
# DATABASE_URL is constructed automatically in docker-compose.yml for the api
# service. You do not need to set DATABASE_URL in .env for Docker Compose unless
# you override the defaults above.
